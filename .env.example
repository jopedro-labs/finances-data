# -----------------------------------------------------------------------------
# finances-data Environment Variables Template
# -----------------------------------------------------------------------------

# Discord incoming webhook URL for CI/bot health notifications.
# Used in: scripts/notify_discord.py, scripts/yahoo_health_check.py
# Required: No (optional for local execution, mandatory for automated alerts)
# Default: unset
INFRA_ALERTS_DISCORD_WEBHOOK=

# Test suite execution status parsed by notification scripts ("ok" | "error").
# Used in: scripts/notify_discord.py
# Required: No
# Default: error
TEST_RESULT=error

# URL hyperlink pointing to the GitHub Actions workflow execution run.
# Used in: scripts/notify_discord.py, scripts/yahoo_health_check.py
# Required: No
# Default: unset
RUN_URL=

# Local/runner path to write step outputs in GitHub Actions environments.
# Used in: scripts/yahoo_health_check.py
# Required: No (only present during GitHub Actions execution)
# Default: unset
GITHUB_OUTPUT=

# Google Gemini API key used by the quality evaluation agent.
# Used in: scripts/quality_eval_agent.py
# Required: Yes (when executing the evaluation agent)
# Default: unset
GEMINI_API_KEY=

# Google Gemini model identifier used for evaluation.
# Used in: scripts/quality_eval_agent.py
# Required: No
# Default: gemini-3.1-pro-preview
GEMINI_MODEL=gemini-3.1-pro-preview
